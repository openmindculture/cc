{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"slug": "contrast",
					"name": "Ink",
					"color": "#1E1E1C"
				},
				{
					"slug": "contrast-quiet",
					"name": "Ink, quiet",
					"color": "#55544E"
				},
				{
					"slug": "base",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "hairline",
					"name": "Hairline (decorative only)",
					"color": "#CFCDC6"
				},
				{
					"slug": "focus",
					"name": "Focus (rings and hover only)",
					"color": "#026576"
				},
				{
					"slug": "field-sage",
					"name": "Field: sage",
					"color": "#DEDFC8"
				},
				{
					"slug": "field-stone",
					"name": "Field: stone",
					"color": "#DAD5C8"
				},
				{
					"slug": "field-lagoon",
					"name": "Field: lagoon",
					"color": "#CFDFDD"
				},
				{
					"slug": "field-rose",
					"name": "Field: rose",
					"color": "#EED6DB"
				},
				{
					"slug": "field-apricot",
					"name": "Field: apricot",
					"color": "#F1DCC4"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "80rem"
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "8",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "16",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "24",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "40",
					"size": "clamp(1.5rem, 3vw, 2.5rem)"
				},
				{
					"slug": "60",
					"name": "64",
					"size": "clamp(2.5rem, 5vw, 4rem)"
				},
				{
					"slug": "70",
					"name": "104",
					"size": "clamp(3.5rem, 8vw, 6.5rem)"
				},
				{
					"slug": "80",
					"name": "gutter",
					"size": "clamp(1rem, 4vw, 2.5rem)"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"customFontSize": false,
			"letterSpacing": false,
			"textTransform": false,
			"fontStyle": true,
			"fontWeight": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Archivo",
					"fontFamily": "Archivo, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/archivo-latin-wdth-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/archivo-latin-ext-wdth-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"slug": "body",
					"name": "Spectral",
					"fontFamily": "Spectral, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-300-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-ext-300-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-400-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-ext-400-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-400-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-ext-400-italic.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-500-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Spectral",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/spectral-latin-ext-500-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Label",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Meta",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "large",
					"name": "Intro",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "quote",
					"name": "Quotation",
					"size": "3.375rem",
					"fluid": {
						"min": "2.125rem",
						"max": "3.375rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Title",
					"size": "6rem",
					"fluid": {
						"min": "3.5rem",
						"max": "6rem"
					}
				},
				{
					"slug": "display",
					"name": "Name",
					"size": "10.5rem",
					"fluid": {
						"min": "4.5rem",
						"max": "10.5rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--80)",
				"right": "var(--wp--preset--spacing--80)",
				"top": "0",
				"bottom": "0"
			},
			"blockGap": "1.25rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--focus)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--focus)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "0"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "300",
					"lineHeight": "0.9"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.5rem"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500"
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--contrast)",
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "400"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--contrast-quiet)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"width": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "300",
					"lineHeight": "1.05"
				}
			},
			"core/pullquote": {
				"border": {
					"width": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "300",
					"lineHeight": "1.05"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"width": "1px 0 0 0"
				}
			},
			"core/details": {
				"border": {
					"top": {
						"width": "1px",
						"style": "solid",
						"color": "var(--wp--preset--color--hairline)"
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "300"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "300"
				}
			}
		}
	}
}
